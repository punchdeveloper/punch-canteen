# PUNCH Canteen — environment settings. Copy to .env and fill in.
# .env is git-ignored; never commit real values.

# PostgreSQL connection (Prisma). Locally: the punch_canteen database on this PC.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/punch_canteen?schema=public"

# Public address of the app — used to build the links in sign-in emails.
APP_URL="http://localhost:3000"

# Outgoing email for magic sign-in links.
# Locally: Laragon's Mailpit (SMTP 127.0.0.1:1025, inbox http://localhost:8025).
# Production: your email provider's SMTP settings (port 465 = TLS).
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="PUNCH Canteen <canteen@punchng.com>"

# Where uploaded menu photos are stored (a persistent volume in production).
STORAGE_DIR="./storage"

# "true" shows/allows the history-clearing tools (Clear orders/transactions/
# test data). Leave "false" in production.
ENABLE_MAINTENANCE_TOOLS="false"

# Informational: the master administrator (seeded with is_master = true).
MASTER_ADMIN_EMAIL="sfolarin@punchng.com"
